<?xml version="1.0" encoding="utf-8"?>
<!--
    Production : HTTPS obligatoire et autorités de confiance Android uniquement.

    Les fournisseurs cartographiques sont des tiers dont GeoSylva ne maîtrise
    pas la rotation des certificats. Aucun pin statique n'est donc livré. Un
    éventuel pinning futur sera réservé à une infrastructure Quintessences
    maîtrisée et accompagné d'une clé de secours réelle.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
